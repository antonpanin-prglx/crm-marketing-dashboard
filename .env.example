# Copy to .env.local and fill in. NEVER commit real secrets — only this example file.

# --- LuxOS gateway mount ---
NEXT_PUBLIC_BASE_PATH=/app/your-dashboard-id   # must match the id registered in LuxOS Admin
# Shared HMAC secret with LuxOS — this is what proves the x-luxos-user-* identity headers
# genuinely came from LuxOS. MUST be byte-identical to the value on the LuxOS project.
# This is the trust anchor; verify the signature before trusting any identity header.
LUXOS_GATEWAY_SECRET=                          # openssl rand -base64 32 (same on LuxOS + here)
LUXOS_URL=https://luxos.pergolux.global        # front door — "Open via LuxOS" page + sign-out
# Optional defense-in-depth only (NOT the identity mechanism). On plans that support it,
# LuxOS passes this to bypass Vercel Deployment Protection on preview. Leave unset otherwise.
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- LuxOS security gate (CI) ---
SECURITY_GATE_SECRET=                          # shared with LuxOS

# --- AI review / deploy (prefer org-level GitHub secrets) ---
# ANTHROPIC_API_KEY=        (GitHub Actions secret, not a runtime var)
# VERCEL_TOKEN=             (GitHub Actions secret)
# VERCEL_PROJECT_ID=        (GitHub Actions repo VARIABLE)

# --- App-specific runtime vars go below ---

# --- Data storage: this app's OWN Supabase project (mandatory; LuxOS sets these on approval) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                     # server-only — NEVER expose to the browser
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
