# --- LuxOS gateway integration (append to your .env.example) ---

# The path this app is mounted at under LuxOS. Must equal the LuxOS dashboard id.
# Build-time (NEXT_PUBLIC_*) — changing it requires a redeploy. Empty = standalone/local.
NEXT_PUBLIC_BASE_PATH=/app/your-app-id

# Shared HMAC secret with LuxOS — verifies that the x-luxos-user-* identity headers
# genuinely came from LuxOS (not a spoofer). MUST be the exact same value set on the
# LuxOS project. NEVER commit the real value. Generate: openssl rand -base64 32
LUXOS_GATEWAY_SECRET=

# LuxOS front door — used for the "Open via LuxOS" page and sign-out.
LUXOS_URL=https://luxos.pergolux.global
