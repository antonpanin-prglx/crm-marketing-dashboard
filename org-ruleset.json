{
  "name": "App security gate (default branch)",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    { "actor_id": 1, "actor_type": "OrganizationAdmin", "bypass_mode": "always" }
  ],
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] },
    "repository_name": { "include": ["luxos", "creative-os", "pergolux-app-template"], "exclude": [], "protected": false }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          { "context": "AI review (Claude)" },
          { "context": "Semgrep — static analysis" },
          { "context": "Trivy — vulns, secrets & misconfig" },
          { "context": "npm audit — dependencies" },
          { "context": "TruffleHog — verified secrets" },
          { "context": "No demo/dummy data" },
          { "context": "LuxOS Security Gate" }
        ]
      }
    },
    { "type": "non_fast_forward" },
    { "type": "deletion" }
  ]
}
